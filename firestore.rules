rules_version = '2';

// قواعد قاعدة بيانات الدعوة
// انسخيها في Firebase Console ← Firestore Database ← Rules ثم Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // ردود تأكيد الحضور:
    // الضيف يقدر يرسل ردّه أو يعدّله، لكن لا أحد يقدر يقرأ الردود أو يحذفها من الموقع.
    // (أنتم تشوفون الردود من لوحة Firebase نفسها)
    match /rsvps/{rsvpId} {
      allow read, delete: if false;
      allow create, update: if validRsvp(request.resource.data);
    }

    // أي شيء آخر مقفل
    match /{document=**} {
      allow read, write: if false;
    }

    // نفس الحقول التي يرسلها الموقع فقط، وبقيم منطقية
    // ملاحظة: الرقم 3 هو maxCompanions في src/config/wedding.js — لو غيّرتيه غيّريه هنا أيضًا
    function validRsvp(d) {
      return d.keys().hasOnly(['name', 'attending', 'companions', 'totalGuests', 'createdAt'])
        && d.keys().hasAll(['name', 'attending', 'companions', 'totalGuests', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.attending is bool
        && d.companions is int && d.companions >= 0 && d.companions <= 3
        && ((d.attending == true && d.totalGuests == d.companions + 1)
          || (d.attending == false && d.companions == 0 && d.totalGuests == 0))
        && d.createdAt == request.time;
    }
  }
}
